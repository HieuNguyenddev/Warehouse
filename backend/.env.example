POSTGRES_PASSWORD=choose-a-long-password
JWT_KEY=replace-with-at-least-32-random-characters
SEED_USERNAME=admin
SEED_PASSWORD=choose-a-long-admin-password
# Docker development và production. Host postgres là tên service trong Compose.
CONNECTION_STRING=Host=postgres;Port=5432;Database=RoleManagementDb;Username=postgres;Password=choose-a-long-password
# dotnet run trên máy development. Đổi host thành IP máy đang chạy PostgreSQL.
CONNECTION_STRING_DEVELOPMENT=Host=127.0.0.1;Port=5432;Database=RoleManagementDb;Username=postgres;Password=choose-a-long-password
