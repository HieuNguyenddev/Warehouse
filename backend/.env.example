POSTGRES_PASSWORD=choose-a-long-password
JWT_KEY=replace-with-at-least-32-random-characters
SEED_USERNAME=admin
SEED_PASSWORD=choose-a-long-admin-password
# Docker development và production. Host postgres là tên service trong Compose.
CONNECTION_STRING=Host=postgres;Port=5432;Database=RoleManagementDb;Username=postgres;Password=choose-a-long-password
# dotnet run trên máy development. Đổi host thành IP máy đang chạy PostgreSQL.
CONNECTION_STRING_DEVELOPMENT=Host=127.0.0.1;Port=5432;Database=RoleManagementDb;Username=postgres;Password=choose-a-long-password
# Khóa S3 của Garage. Docker Compose bắt buộc ba dòng này. scripts/ensure-garage.sh tự sinh nếu thiếu.
# GARAGE_ACCESS_KEY là GK cộng 30 ký tự hex. GARAGE_SECRET_KEY là 64 ký tự hex.
GARAGE_ACCESS_KEY=GK0123456789abcdef0123456789abcd
GARAGE_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_BUCKET=warehouse
# Chỉ khi dotnet run trên máy development và Garage mở ở localhost. Container API không đọc dòng này.
# GARAGE_ENDPOINT=http://127.0.0.1:3900
# Secret Turnstile. Site Key production chỉ ghi trong frontend/.env.production.
# Để trống thì API bỏ qua bước kiểm tra.
TURNSTILE_SECRET_KEY=

